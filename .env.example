# 本地网页版默认读这个文件：/resume-bot/.env

# MiniMax Coding Plan / 文本模型
# 如果你用的是 Coding Plan Key（通常长得像 sk-cp-...），当前官方页面列出的支持模型是 MiniMax-M2.1 / MiniMax-M2。
RESUME_BOT_LLM_PROVIDER=minimax-anthropic
RESUME_BOT_LLM_BASE_URL=
RESUME_BOT_LLM_API_KEY=
RESUME_BOT_LLM_MODEL=

# 视觉/OCR。你之前说自己有阿里云百炼，可以继续填这里
RESUME_BOT_VISION_PROVIDER=openai-compatible
RESUME_BOT_VISION_BASE_URL=
RESUME_BOT_VISION_API_KEY=
RESUME_BOT_VISION_MODEL=

# 可选：公开源搜索
TAVILY_API_KEY=

# 可选：如果 boss-cli 不在 PATH 里，可以手动指定命令
# Windows 示例：RESUME_BOT_BOSS_CLI_CMD=E:\jianli\resume-bot\.venv\Scripts\boss.exe
RESUME_BOT_BOSS_CLI_CMD=
RESUME_BOT_BOSS_CLI_TIMEOUT_SEC=90

# 可选：本地调试时把 BOSS 浏览器改成非 headless
# RESUME_BOT_BOSS_BROWSER_HEADLESS=0
